# SAPC-ONAC Web (Next.js 16) — Dockerfile de DESARROLLO
# Imagen Node.js 26.8.2 con pnpm 9 para hot reload (turbopack).
# No compila, solo deja el código listo para `pnpm dev`.
#
# En producción: usar docker/web.Dockerfile (multi-stage con standalone output).

FROM node:26.8.2-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates git \
      libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Habilitar pnpm via corepack
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# El código se monta via bind-mount en docker-compose.dev.yml
# Aquí solo pre-cargamos package.jsons para cache de instalación
COPY apps/web/package.json ./apps/web/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./

# Prisma CLI (necesario para db:push, db:seed)
RUN pnpm install --no-frozen-lockfile || true

EXPOSE 3000

# El command real lo define docker-compose.dev.yml (pnpm dev)
CMD ["echo", "Use docker compose -f infra/docker/docker-compose.dev.yml up web"]
