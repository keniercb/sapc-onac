# SAPC-ONAC — .env para sandbox sin Docker (SQLite)
# Copia este archivo a `.env` y ejecuta:
#   ./scripts/switch-db.sh sqlite
#   pnpm install
#   pnpm --filter @sapc/web db:push
#   pnpm --filter @sapc/web db:seed
#   pnpm dev

NODE_ENV=development
TZ=America/Havana

# SQLite local
DATABASE_URL=file:/home/z/my-project/db/custom.db

# API base URL para el frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# JWT (no se usa en sandbox, pero requerido por el backend)
JWT_SECRET=dev_secret_change_in_prod
