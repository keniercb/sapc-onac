# SAPC-ONAC — Configuración pnpm global
#
# Este archivo es leído por pnpm en todos los paquetes del monorepo.
# Las variables HTTP_PROXY/HTTPS_PROXY se respetan automáticamente cuando
# están presentes en el entorno (ver .env.example sección "Proxy corporativo").
#
# Para usar un mirror npm local (Verdaccio, Nexus), descomenta:
# registry=http://npm-mirror.onac.cu:4873

# Timeouts amplios para conexiones lentas (proxy Cuba)
fetch-retries=5
fetch-retry-maxtimeout=120000
fetch-timeout=300000

# Peer deps
strict-peer-dependencies=false
auto-install-peers=true

# Hoisting: dependencias compartidas accesibles desde todos los workspaces.
# Esto resuelve el problema de "module not found" en apps/api cuando se usa
# node-linker=isolated (default de pnpm 9). Next.js funciona correctamente
# con esta configuración.
public-hoist-pattern[]=*
shamefully-hoist=true
