# SAPC-ONAC — Variables de entorno de ejemplo
# Copia este archivo a `.env` (desarrollo) o `.env.production` (producción)
# y ajusta los valores según tu entorno.
#
# En desarrollo: docker compose -f infra/docker/docker-compose.dev.yml --env-file .env up -d
# En producción: docker compose -f infra/docker/docker-compose.yml --env-file .env.production up -d

# ===== Comunes =====
NODE_ENV=development
TZ=America/Havana

# ===== PostgreSQL =====
# Puerto expuesto en el host (5432 por defecto)
POSTGRES_PORT=5432
# Contraseña del usuario `sapc` — en prod debe ser aleatoria y fuerte
POSTGRES_PASSWORD=sapc_dev_pwd

# ===== Redis =====
REDIS_PORT=6379

# ===== Backend API =====
# Puerto expuesto en el host
API_PORT=4000
# En prod: usar una cadena aleatoria de 64+ caracteres (p. ej. `openssl rand -hex 32`)
JWT_SECRET=dev_secret_change_in_prod

# ===== Frontend Web =====
WEB_PORT=3000
# URL pública del API (en dev: localhost, en prod: dominio del backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ===== Solo prod: dominios y TLS =====
# NEXT_PUBLIC_API_URL=https://api.onac.cu
# CORS_ORIGIN=https://app.onac.cu

# ===== Proxy corporativo (Cuba / intranet ONAC) =====
# Descomenta y ajusta si el servidor está detrás de un proxy corporativo.
# Estas variables se pasan a los contenedores Docker en build-time y runtime
# para que apt-get, pnpm, bun y otras herramientas puedan acceder a internet.
#
# IMPORTANTE: para build-time, ejecuta docker compose con --build:
#   docker compose -f infra/docker/docker-compose.dev.yml --env-file .env build --no-cache
#
# HTTP_PROXY=http://proxy.onac.cu:8080
# HTTPS_PROXY=http://proxy.onac.cu:8080
# NO_PROXY=localhost,127.0.0.1,postgres,redis,api,web,localhost,*.onac.cu
# NO_PROXY_HOSTS=localhost,127.0.0.1,postgres,redis,api,web

# ===== npm/pnpm registry (opcional — mirror local) =====
# Si usas un mirror npm local (Verdaccio/Nexus), descomenta:
# npm_config_registry=http://npm-mirror.onac.cu:4873

# ===== Bun install (opcional — proxy para bun.sh) =====
# BUN_CONFIG_HTTP_PROXY=http://proxy.onac.cu:8080

