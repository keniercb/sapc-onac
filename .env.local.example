# SAPC-ONAC — .env para desarrollo local híbrido
#
# Usar con: docker compose -f infra/docker/docker-compose.local.yml --env-file .env.local up -d
# O con: make local-up (carga .env.local automáticamente)
#
# En este modo:
#  - PostgreSQL + Redis corren en Docker
#  - API (Hono) y Web (Next.js) corren en el host con `pnpm dev:api` y `pnpm dev:web`
#  - Hot reload instantáneo (sin Docker filesystem polling)
#  - DATABASE_URL apunta a localhost (no al nombre del contenedor)

NODE_ENV=development
TZ=America/Havana

# ===== PostgreSQL (Docker) =====
# Puerto expuesto en el host
POSTGRES_PORT=5432
# Contraseña del usuario sapc
POSTGRES_PASSWORD=sapc_dev_pwd
# DATABASE_URL apunta a localhost (no a 'postgres' como en docker-compose.dev.yml)
DATABASE_URL=postgresql://sapc:sapc_dev_pwd@localhost:5432/sapc_onac_dev?schema=public

# ===== Redis (Docker) =====
REDIS_PORT=6379

# ===== Backend API (host) =====
PORT=4000
JWT_SECRET=dev_secret_change_in_prod
CORS_ORIGIN=http://localhost:3000

# ===== Frontend Web (host) =====
NEXT_PUBLIC_API_URL=http://localhost:4000

# ===== Proxy corporativo (Cuba) =====
# Descomenta si estás detrás de un proxy:
# HTTP_PROXY=http://proxy.onac.cu:8080
# HTTPS_PROXY=http://proxy.onac.cu:8080
# NO_PROXY=localhost,127.0.0.1

# ===== Mirror npm local (opcional) =====
# npm_config_registry=http://npm-mirror.onac.cu:4873
