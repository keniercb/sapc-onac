{
  "name": "@sapc/api",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate --schema=prisma/schema.prisma",
    "dev": "tsx watch src/index.ts",
    "dev:bun": "prisma generate --schema=prisma/schema.prisma && bun --hot src/index.ts",
    "start": "tsx src/index.ts",
    "start:bun": "bun src/index.ts",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate --schema=prisma/schema.prisma || echo 'Prisma generate skipped (no DATABASE_URL or prisma not yet installed)'",
    "db:push": "dotenv -e ../../.env -- prisma db push --accept-data-loss --schema=prisma/schema.prisma",
    "db:generate": "dotenv -e ../../.env -- prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema=prisma/schema.prisma",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --schema=prisma/schema.prisma",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/zod-validator": "^0.4.0",
    "@prisma/client": "^6.11.0",
    "zod": "^4.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "dotenv-cli": "^7.4.0",
    "prisma": "^6.11.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
