# SAPC-ONAC API — Variables de entorno de ejemplo
#
# Prisma busca automáticamente este archivo (.env) en el directorio apps/api/.
# Copia este archivo a .env y ajusta el valor de DATABASE_URL.
#
# IMPORTANTE: si tu .env principal está en la raíz del monorepo (recomendado),
# los scripts `pnpm db:push`, `pnpm db:seed`, etc. ya cargan automáticamente
# ese archivo via dotenv-cli (ver apps/api/package.json).

# PostgreSQL (dev con Docker)
DATABASE_URL=postgresql://sapc:sapc_dev_pwd@localhost:5432/sapc_onac_dev?schema=public

# SQLite (sandbox sin Docker) — descomenta y comenta la línea anterior:
# DATABASE_URL=file:./dev.db

# JWT (para generar tokens en prod — sandbox usa cookie simple)
JWT_SECRET=dev_secret_change_in_prod

# CORS — origen del frontend
CORS_ORIGIN=http://localhost:3000

# Puerto del API (fijo en 4000 — coincide con docker-compose)
PORT=4000
